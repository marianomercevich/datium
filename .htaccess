RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → apex (coincide con canonical y Search Console)
RewriteCond %{HTTP_HOST} ^www\.datiumtech\.com\.ar$ [NC]
RewriteRule ^ https://datiumtech.com.ar%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# Página propia cuando falta una URL o el servidor niega el acceso
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
